generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password      String
  role          String       @default("user") // "user" | "admin"
  school        String?
  studentId     String?
  phone         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  submissions   Submission[]
  notifications Notification[]
}

model Competition {
  id             String       @id @default(cuid())
  title          String
  description    String
  content        String       // 赛题详细内容 (Markdown)
  attachmentName String?      // 附件原始文件名
  attachmentPath String?      // 附件存储路径
  attachments    String?      // JSON array of {name, path} for multiple attachments
  startTime      DateTime
  endTime        DateTime
  status         String       @default("draft") // "draft" | "active" | "ended"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submissions    Submission[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  pinned    Boolean  @default(false) // 是否置顶
  published Boolean  @default(true)  // 是否发布
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default("default")
  siteName  String   @default("数学建模竞赛平台")
  siteDesc  String   @default("数学建模竞赛在线平台 - 赛题发布、论文提交、成绩查询")
  heroTitle String   @default("数学建模竞赛平台")
  heroDesc  String   @default("参与数学建模竞赛，提升解决实际问题的能力，展现你的数学才华")
  footerText String  @default("数学建模竞赛平台")
  primaryColor String @default("#2563eb")
  secondaryColor String? // 渐变副色 (可选，启用 gradientEnabled 时生效)
  gradientEnabled Boolean @default(false)
  gradientAngle Int @default(160) // 渐变角度 0-360
  logoUrl   String?
  bannerText String?
  bannerEnabled Boolean @default(false)
  maxFileSize Int    @default(10)
  maxSubmissionVersions Int @default(5) // 截止前重交保留的最近版本数上限
  updatedAt DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?   // 失败原因
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "graded" | "submission_deleted" | "announcement" | "system"
  title     String
  content   String?
  link      String?  // 点击跳转路径
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Submission {
  id            String      @id @default(cuid())
  fileName      String
  filePath      String
  extraFiles    String?      // JSON array of {name, path} for additional files
  teamName      String?
  teamMembers   String?     // JSON string of team members
  notes         String?
  score         Float?
  feedback      String?
  award         String?      // "special" | "first" | "second" | "third" | "excellent" | null
  showcased     Boolean     @default(false) // 是否在公示板展示
  status        String      @default("pending") // "pending" | "graded"
  parentId      String?     // 上一个被替换的版本 id（链表）
  isLatest      Boolean     @default(true) // 当前是否为该 (user, competition) 下最新版本
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  competitionId String
  user          User        @relation(fields: [userId], references: [id])
  competition   Competition @relation(fields: [competitionId], references: [id])

  @@index([userId])
  @@index([competitionId])
  @@index([status])
  @@index([showcased, award])
  @@index([createdAt])
  @@index([userId, competitionId, isLatest])
}
