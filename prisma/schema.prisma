generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password      String
  role          String       @default("user") // "user" | "judge" | "admin" | "super_admin"
  school        String?
  studentId     String?
  phone         String?
  calendarToken String?      @unique // 个人 iCal 订阅 token（首次访问时生成）
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  submissions   Submission[]
  notifications Notification[]
  comments      ShowcaseComment[]
  likes         ShowcaseLike[]
  teamMemberships TeamMember[]
  teamJoinRequests TeamJoinRequest[]
  ledTeams      Team[]       @relation("TeamLeader")
  judgeScores   JudgeScore[]
}

model Competition {
  id             String       @id @default(cuid())
  title          String
  description    String
  content        String       // 赛题详细内容 (Markdown)
  attachmentName String?      // 附件原始文件名
  attachmentPath String?      // 附件存储路径
  attachments    String?      // JSON array of {name, path} for multiple attachments
  teamMaxMembers Int          @default(5)
  startTime      DateTime
  endTime        DateTime
  status         String       @default("draft") // "draft" | "active" | "ended"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submissions    Submission[]
  teams          Team[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  pinned    Boolean  @default(false) // 是否置顶
  published Boolean  @default(true)  // 是否发布
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default("default")
  siteName  String   @default("数学建模竞赛平台")
  siteDesc  String   @default("数学建模竞赛在线平台 - 赛题发布、论文提交、成绩查询")
  heroTitle String   @default("数学建模竞赛平台")
  heroDesc  String   @default("参与数学建模竞赛，提升解决实际问题的能力，展现你的数学才华")
  footerText String  @default("数学建模竞赛平台")
  primaryColor String @default("#2563eb")
  secondaryColor String? // 渐变副色 (可选，启用 gradientEnabled 时生效)
  gradientEnabled Boolean @default(false)
  gradientAngle Int @default(160) // 渐变角度 0-360
  logoUrl   String?
  bannerText String?
  bannerEnabled Boolean @default(false)
  maxFileSize Int    @default(10)
  maxSubmissionVersions Int @default(5) // 截止前重交保留的最近版本数上限
  commentsEnabled Boolean @default(true) // 公示作品是否开放评论与点赞
  updatedAt DateTime @updatedAt
}

model GuideDoc {
  key       String   @id // "user" | "changelog"
  content   String   // markdown 正文
  updatedAt DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?   // 失败原因
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "graded" | "submission_deleted" | "announcement" | "system"
  title     String
  content   String?
  link      String?  // 点击跳转路径
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Submission {
  id            String      @id @default(cuid())
  fileName      String
  filePath      String
  extraFiles    String?      // JSON array of {name, path} for additional files
  teamName      String?
  teamMembers   String?     // JSON string of team members
  notes         String?
  score         Float?
  feedback      String?
  award         String?      // "special" | "first" | "second" | "third" | "excellent" | null
  showcased     Boolean     @default(false) // 是否在公示板展示
  status        String      @default("pending") // "pending" | "graded"
  parentId      String?     // 上一个被替换的版本 id（链表）
  isLatest      Boolean     @default(true) // 当前是否为该 (user, competition) 下最新版本
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  competitionId String
  teamId        String?     // 团队赛 id；旧数据/个人提交为 null
  user          User        @relation(fields: [userId], references: [id])
  competition   Competition @relation(fields: [competitionId], references: [id])
  team          Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  comments      ShowcaseComment[]
  likes         ShowcaseLike[]
  judgeScores   JudgeScore[]

  @@index([userId])
  @@index([competitionId])
  @@index([status])
  @@index([showcased, award])
  @@index([createdAt])
  @@index([userId, competitionId, isLatest])
}

// 赛题模板：admin 可保存常用赛题结构以便后续快速创建
model CompetitionTemplate {
  id          String   @id @default(cuid())
  name        String   // 模板名（仅给 admin 看）
  title       String   // 默认赛题标题
  description String   // 默认简介
  content     String   // 默认 Markdown 详情
  durationDays Int     @default(7) // 创建赛题时的默认开放时长
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 公示作品评论
model ShowcaseComment {
  id           String     @id @default(cuid())
  submissionId String
  userId       String
  content      String
  hidden       Boolean    @default(false) // admin 可隐藏不当评论
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId, hidden, createdAt])
  @@index([userId])
}

// 公示作品点赞（一个用户对一个 submission 仅能点一次）
model ShowcaseLike {
  userId       String
  submissionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([userId, submissionId])
  @@index([submissionId])
}

// =============== 团队赛 ===============
// 用户在某个赛题下创建的队伍。一个用户每个赛题最多隶属一个队。
model Team {
  id            String       @id @default(cuid())
  name          String
  inviteCode    String       @unique // 6-8 位易读邀请码
  competitionId String
  leaderId      String       // 创建者
  maxMembers    Int          @default(5) // 队员人数上限（含队长）
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  leader        User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members       TeamMember[]
  joinRequests  TeamJoinRequest[]
  submissions   Submission[]

  @@index([competitionId])
  @@index([leaderId])
}

model TeamMember {
  teamId   String
  userId   String
  role     String   @default("member") // "leader" | "member"
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model TeamJoinRequest {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  message   String?
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
}

// =============== 多评委打分 ===============
// 每个评委对每个 submission 至多一条记录
model JudgeScore {
  id           String     @id @default(cuid())
  submissionId String
  judgeId      String
  score        Float
  feedback     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge        User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
  @@index([judgeId])
}
